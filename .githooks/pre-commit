#!/bin/sh
set -eu

staged_files=$(git diff --cached --name-only --diff-filter=ACMR)

if printf '%s\n' "$staged_files" | grep -q '^apps/screen-linux/'; then
    echo "Checking Linux screen helper formatting..."
    cargo fmt --manifest-path apps/screen-linux/Cargo.toml -- --check
fi

if printf '%s\n' "$staged_files" | grep -q '^apps/screen-macos/'; then
    if [ "$(uname -s)" = "Darwin" ]; then
        echo "Checking macOS screen helper syntax..."
        xcrun swiftc -parse apps/screen-macos/*.swift
    else
        echo "Skipping macOS screen helper syntax check (requires macOS)."
    fi
fi
